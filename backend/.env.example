# Local host API with MySQL/Redis from backend/docker-compose.yml only.
# Do not use these public development credentials for a deployment.
NODE_ENV=development
PORT=3000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=mysql://appuser:apppass@127.0.0.1:3307/huellas
SHADOW_DATABASE_URL=mysql://root:root@127.0.0.1:3307/huellas_shadow
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=appuser
DB_PASSWORD=apppass
DB_NAME=huellas
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=huellas-local-development-only
# Optional, independent operator secret of at least 32 characters. Empty disables /metrics.
METRICS_TOKEN=
