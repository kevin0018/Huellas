generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  relationMode      = "foreignKeys"
}

// --- Enums ---

enum UserType {
  owner
  volunteer
}

enum PetType {
  dog
  cat
  ferret
}

enum PetSize {
  large
  medium
  small
}

enum Sex {
  male
  female
}

enum AppointmentReason {
  VACCINATION
  GENERAL_CHECKUP
  ANTI_PARASITIC_PRESCRIPTION
  OPERATION
  OTHERS
}

enum AppointmentStatus {
  scheduled
  completed
  cancelled
  no_show
}

enum HealthEventType {
  VACCINATION
  GENERAL_CHECKUP
  MEDICATION
  TREATMENT
  TEST
  SURGERY
  WEIGHT
  OTHER
}

enum HealthEventSource {
  OWNER
  LEGACY_CHECKUP
  APPOINTMENT
}

enum ReminderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum ReminderSource {
  APPOINTMENT
  PREVENTIVE_PLAN
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
  CLOSED
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  EXPIRED
}

enum PostCategory {
  GENERAL
  WALKING_EXERCISE
  PET_SITTING
  VET_TRANSPORT
  FOSTER_CARE
  TRAINING_BEHAVIOR
  SHELTER_SUPPORT
  GROOMING_HYGIENE
  MEDICAL_SUPPORT
  ADOPTION_REHOMING
  LOST_AND_FOUND
}

// --- Models ---

model User {
  id        Int        @id @default(autoincrement())
  name      String
  last_name String
  email     String     @unique
  password  String
  type      UserType
  owner     Owner?
  volunteer Volunteer?

  // Chat system relations
  created_conversations     Conversation[]            @relation("CreatedConversations")
  conversation_participants ConversationParticipant[]
  sent_messages             Message[]

  // Volunteer post relations
  authored_posts VolunteerPost[] @relation("AuthoredPosts")
  entered_health_events  HealthEvent[] @relation("EnteredHealthEvents")
  verified_health_events HealthEvent[] @relation("VerifiedHealthEvents")

  @@index([type])
  @@index([email])
}

model Owner {
  id                    Int     @id
  notifications_enabled Boolean @default(true)
  reminder_lead_days    Int     @default(14)
  user                  User    @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  pets                  Pet[]
}

model Volunteer {
  id          Int    @id
  description String
  user        User   @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model Pet {
  id                Int      @id @default(autoincrement())
  name              String
  race              String?
  type              PetType
  owner_id          Int
  birth_date        DateTime @db.Date
  size              PetSize
  microchip_code    String?  @unique
  sex               Sex
  has_passport      Boolean
  country_of_origin String?
  passport_number   String?
  notes             String?
  allergies         String?  @db.Text
  active_medications String? @db.Text
  medical_conditions String? @db.Text

  owner        Owner         @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  checkups     Checkup[]
  appointments Appointment[]
  health_events HealthEvent[]
  health_documents HealthDocument[]
  reminders Reminder[]

  @@index([owner_id])
  @@index([type])
  @@index([size])
  @@index([sex])
  @@index([birth_date])
}

model Checkup {
  id           Int      @id @default(autoincrement())
  pet_id       Int
  procedure_id Int
  date         DateTime @db.Date
  notes        String?

  pet       Pet               @relation(fields: [pet_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  procedure ProcedureSchedule @relation(fields: [procedure_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([pet_id])
  @@index([procedure_id])
  @@index([date])
  @@index([pet_id, date])
}

model Appointment {
  id     Int               @id @default(autoincrement())
  pet_id Int
  date   DateTime
  reason AppointmentReason
  status AppointmentStatus @default(scheduled)
  notes  String?

  pet Pet @relation(fields: [pet_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  health_events HealthEvent[]

  @@index([pet_id])
  @@index([date])
  @@index([pet_id, date])
}

model HealthEvent {
  id                    Int               @id @default(autoincrement())
  pet_id                Int
  type                  HealthEventType
  occurred_at           DateTime
  title                 String
  notes                 String?           @db.Text
  provider              String?
  result                String?           @db.Text
  dose                  String?
  lot_number            String?
  expires_at            DateTime?
  entered_by            Int
  verified_by           Int?
  source                HealthEventSource @default(OWNER)
  source_appointment_id Int?
  legacy_checkup_id     Int?              @unique
  created_at            DateTime          @default(now())
  updated_at            DateTime          @updatedAt

  pet                Pet          @relation(fields: [pet_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  enteredBy          User         @relation("EnteredHealthEvents", fields: [entered_by], references: [id], onDelete: Restrict, onUpdate: Restrict)
  verifiedBy         User?        @relation("VerifiedHealthEvents", fields: [verified_by], references: [id], onDelete: SetNull, onUpdate: Restrict)
  sourceAppointment Appointment? @relation(fields: [source_appointment_id], references: [id], onDelete: SetNull, onUpdate: Restrict)
  attachments       HealthDocument[]

  @@index([pet_id, occurred_at])
  @@index([type])
  @@index([expires_at])
  @@index([source_appointment_id])
}

model HealthDocument {
  id              Int      @id @default(autoincrement())
  pet_id          Int
  health_event_id Int?
  file_name       String
  mime_type       String
  size_bytes      Int
  content         Bytes    @db.LongBlob
  created_at      DateTime @default(now())

  pet         Pet          @relation(fields: [pet_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  healthEvent HealthEvent? @relation(fields: [health_event_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([pet_id])
  @@index([health_event_id])
}

model ProcedureSchedule {
  id                       Int     @id @default(autoincrement())
  animal_type              PetType
  procedure_name           String
  recommended_vaccines_age Int
  procedure_type           HealthEventType @default(OTHER)
  recurrence_days          Int?
  due_window_before_days   Int             @default(14)
  due_window_after_days    Int             @default(14)
  region                   String          @default("ES")
  source                   String          @default("Huellas MVP guidance")
  version                  String          @default("2026.1")
  notes                    String?

  checkups Checkup[]
  reminders Reminder[]

  @@unique([animal_type, procedure_name])
  @@index([animal_type])
  @@index([procedure_name])
}

model Reminder {
  id                      Int            @id @default(autoincrement())
  pet_id                  Int
  source                  ReminderSource
  source_key              String         @unique
  preventive_procedure_id Int?
  title                   String
  due_at                  DateTime
  status                  ReminderStatus @default(PENDING)
  snoozed_until           DateTime?
  completed_at            DateTime?
  cancelled_at            DateTime?
  generated_action_at     DateTime?
  created_at              DateTime       @default(now())
  updated_at              DateTime       @updatedAt

  pet Pet @relation(fields: [pet_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  preventiveProcedure ProcedureSchedule? @relation(fields: [preventive_procedure_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([pet_id, status, due_at])
  @@index([preventive_procedure_id])
}

model Conversation {
  id         Int                @id @default(autoincrement())
  title      String?
  status     ConversationStatus @default(ACTIVE)
  created_at DateTime           @default(now())
  updated_at DateTime           @updatedAt
  created_by Int

  creator      User                      @relation("CreatedConversations", fields: [created_by], references: [id], onDelete: Cascade, onUpdate: Restrict)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([status])
  @@index([created_by])
  @@index([created_at])
  @@index([updated_at])
}

model ConversationParticipant {
  id              Int       @id @default(autoincrement())
  conversation_id Int
  user_id         Int
  joined_at       DateTime  @default(now())
  last_read_at    DateTime?

  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([conversation_id, user_id])
  @@index([conversation_id])
  @@index([user_id])
  @@index([joined_at])
}

model Message {
  id              Int         @id @default(autoincrement())
  conversation_id Int
  sender_id       Int
  content         String      @db.Text
  type            MessageType @default(TEXT)
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt
  edited_at       DateTime?

  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  sender       User         @relation(fields: [sender_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([conversation_id])
  @@index([sender_id])
  @@index([created_at])
  @@index([conversation_id, created_at])
}

model VolunteerPost {
  id           Int          @id @default(autoincrement())
  title        String
  content      String       @db.Text
  author_id    Int
  category     PostCategory @default(GENERAL)
  status       PostStatus   @default(DRAFT)
  created_at   DateTime     @default(now())
  updated_at   DateTime     @updatedAt
  published_at DateTime?
  expires_at   DateTime?

  author User @relation("AuthoredPosts", fields: [author_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([author_id])
  @@index([category])
  @@index([status])
  @@index([created_at])
  @@index([published_at])
  @@index([expires_at])
  @@index([category, status])
  @@index([status, published_at])
}
